# Sao chép file này thành .env.local rồi điền khóa. Chỉ cần MỘT nhà cung cấp là đủ.
# Tất cả các lựa chọn dưới đây đều có gói MIỄN PHÍ, không cần thẻ thanh toán.

# Thứ tự thử: khi một nơi hết lượt miễn phí (lỗi 429) sẽ tự chuyển sang nơi tiếp theo.
AI_PROVIDERS=gemini,groq,openrouter

# 1) Google Gemini — lấy khóa tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# 2) Groq — lấy khóa tại https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# 3) OpenRouter — chỉ dùng các model có đuôi ":free" — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4) Ollama — chạy model mã nguồn mở trên máy chủ của bạn: miễn phí vĩnh viễn, không phụ thuộc ai.
#    Cài https://ollama.com, chạy `ollama pull qwen2.5:7b`, rồi thêm "ollama" vào AI_PROVIDERS.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# Giới hạn số câu hỏi mỗi phút cho mỗi học viên (bảo vệ hạn mức miễn phí)
# AI_RATE_LIMIT_PER_MINUTE=15
